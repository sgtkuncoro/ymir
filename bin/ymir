#!/usr/bin/env bash
#
# ymir - sync/mirror a managed list of paths across a Tailscale tailnet.
#
# Model: one-way PULL from a single hub (source of truth) to this machine.
#   - The hub owns the manifest (~/.config/ymir/paths.list) and the canonical files.
#   - Paths are stored HOME-relative, so a hub user (e.g. "alice") and a local user
#     (e.g. "bob") map correctly even though /Users/<name> differs.
#   - `add`/`rm`/`list` edit the hub manifest. `sync` pulls hub -> local.
#   - Files are kept in place (no symlinks). Secrets are excluded by default.
#
# Transport: ssh over Tailscale (hub reached by its MagicDNS name). A `local`
# transport exists for testing (treats $HUB_ROOT as a fake hub home).
#
set -euo pipefail

CFG_DIR="${YMIR_CFG_DIR:-$HOME/.config/ymir}"
CFG_FILE="$CFG_DIR/config"
LOCAL_MANIFEST="$CFG_DIR/paths.list.cache"
STATE_FILE="$CFG_DIR/last-sync"
LOG_FILE="${YMIR_LOG:-$CFG_DIR/ymir.log}"

# --- defaults (overridable in $CFG_FILE) ---------------------------------
HUB_HOST="hub"          # your hub's Tailscale MagicDNS name (override in config)
HUB_USER=""              # REQUIRED: local macOS username on the hub
TRANSPORT="ssh"         # ssh | local
HUB_ROOT=""             # only for TRANSPORT=local: path acting as hub $HOME
IS_HUB="0"              # 1 => THIS machine is the hub (curate here; sync is a no-op)
MIRROR="0"              # 1 => rsync --delete (destructive on the receiver)
INTERVAL="300"          # launchd StartInterval seconds
HUB_RSYNC_PATH=""       # optional --rsync-path for the hub (e.g. /opt/homebrew/bin/rsync)
SSH_OPTS="-o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=accept-new"

# Secret patterns excluded from every transfer AND blocked by `add` (use --force).
SECRET_PATTERNS=(
  ".ssh/*" "id_rsa" "id_ed25519" "*.pem" "*.key" "*.p12" "*.pfx"
  "*.keychain*" ".aws/credentials" ".gnupg/*" ".netrc" "*.env" ".env"
)

REMOTE_MANIFEST='$HOME/.config/ymir/paths.list'   # expanded on the hub

# --- helpers -------------------------------------------------------------
die()  { printf 'ymir: %s\n' "$*" >&2; exit 1; }
warn() { printf 'ymir: %s\n' "$*" >&2; }
log()  { printf '%s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*" >>"$LOG_FILE"; }

# Interactive prompt helpers (fall back to defaults when not a TTY).
ask() { # <var> <prompt> [default]
  local __v="$1" __p="$2" __d="${3:-}" __a=""
  if [ -t 0 ]; then
    printf '%s' "$__p" >&2; [ -n "$__d" ] && printf ' [%s]' "$__d" >&2; printf ': ' >&2
    IFS= read -r __a || __a=""
  fi
  [ -z "$__a" ] && __a="$__d"
  printf -v "$__v" '%s' "$__a"
}
confirm() { # <prompt> [Y|N]
  local __p="$1" __d="${2:-Y}" __a=""
  if [ -t 0 ]; then printf '%s [%s]: ' "$__p" "$__d" >&2; IFS= read -r __a || __a=""; else __a="$__d"; fi
  [ -z "$__a" ] && __a="$__d"
  case "$__a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

load_cfg() {
  mkdir -p "$CFG_DIR"
  [ -f "$CFG_FILE" ] && . "$CFG_FILE"
  if [ "$IS_HUB" = "1" ]; then       # hub mode: operate on this machine's own home
    TRANSPORT="local"; HUB_ROOT="$HOME"; return
  fi
  [ "$TRANSPORT" = "local" ] && { [ -n "$HUB_ROOT" ] || die "TRANSPORT=local requires HUB_ROOT"; return; }
  [ -n "$HUB_USER" ] || die "HUB_USER not set. Run 'ymir setup' (or set HUB_USER in $CFG_FILE)."
}

# Run a command string in the hub's shell.
hub_exec() {
  case "$TRANSPORT" in
    ssh)   ssh $SSH_OPTS "$HUB_USER@$HUB_HOST" "$1" ;;
    local) ( export HOME="$HUB_ROOT"; bash -c "$1" ) ;;
    *)     die "unknown TRANSPORT: $TRANSPORT" ;;
  esac
}

rsync_bin() { command -v /opt/homebrew/bin/rsync >/dev/null 2>&1 && echo /opt/homebrew/bin/rsync || echo rsync; }

# Build an rsync --exclude args array into global REX.
build_excludes() {
  REX=()
  local p
  for p in "${SECRET_PATTERNS[@]}"; do REX+=(--exclude="$p"); done
}

# Normalise an input path to a HOME-relative entry (or absolute if outside HOME).
to_rel() {
  local in="$1" abs
  case "$in" in
    "~/"*) in="$HOME/${in#\~/}" ;;
    "~")   in="$HOME" ;;
  esac
  # absolutise without requiring existence
  case "$in" in
    /*) abs="$in" ;;
    *)  abs="$PWD/$in" ;;
  esac
  # strip trailing slash
  abs="${abs%/}"
  case "$abs/" in
    "$HOME/"*) printf '%s' "${abs#$HOME/}" ;;
    *)         printf '%s' "$abs" ;;  # outside HOME: keep absolute (won't remap)
  esac
}

is_secret() {
  local rel="$1" base pat
  base="$(basename "$rel")"
  for pat in "${SECRET_PATTERNS[@]}"; do
    # shellcheck disable=SC2053
    case "$rel"  in $pat) return 0 ;; esac
    case "$base" in $pat) return 0 ;; esac
  done
  return 1
}

read_manifest() { hub_exec "cat $REMOTE_MANIFEST 2>/dev/null" | sed '/^\s*#/d; /^\s*$/d'; }

# --- commands ------------------------------------------------------------
cmd_init() {
  mkdir -p "$CFG_DIR"
  if [ -f "$CFG_FILE" ]; then warn "config already exists at $CFG_FILE"; return; fi
  cat >"$CFG_FILE" <<EOF
# ymir config ($(hostname))
HUB_HOST="hub"           # your hub's Tailscale MagicDNS name
HUB_USER=""              # REQUIRED: run 'id -un' on the hub and paste it here
IS_HUB="0"               # set to 1 ON THE HUB to curate paths there directly
TRANSPORT="ssh"          # ssh | local
MIRROR="0"               # 1 => delete files on this machine that are gone on the hub
INTERVAL="300"           # launchd sync interval (seconds)
HUB_RSYNC_PATH=""        # e.g. /opt/homebrew/bin/rsync if the hub has GNU rsync
EOF
  printf 'Wrote %s\nSet HUB_USER, then: ymir status\n' "$CFG_FILE"
}

cmd_setup() {
  mkdir -p "$CFG_DIR"
  echo "== ymir setup ==" >&2; echo >&2

  # 1. prerequisites
  if command -v tailscale >/dev/null 2>&1; then
    if tailscale status >/dev/null 2>&1; then echo "[ok] tailscale connected" >&2
    else warn "tailscale installed but not connected - run: tailscale up"; fi
  else warn "tailscale not found - install from https://tailscale.com/download, then re-run"; fi
  if command -v /opt/homebrew/bin/rsync >/dev/null 2>&1; then
    echo "[ok] GNU rsync present" >&2
  elif command -v brew >/dev/null 2>&1 && confirm "GNU rsync missing. Install with brew now?" Y; then
    brew install rsync >&2 || warn "brew install rsync failed - install it manually"
  else warn "GNU rsync recommended: brew install rsync"; fi
  echo >&2

  # 2. role
  local role ishub="0" hubhost="$HUB_HOST" hubuser="" rsyncpath=""
  ask role "Is this machine the HUB (curate here) or a SPOKE (receives config)? (hub/spoke)" "spoke"
  case "$role" in hub|HUB|h|H) ishub="1" ;; *) ishub="0" ;; esac

  if [ "$ishub" = "1" ]; then
    ask hubhost "Label for this hub (cosmetic)" "$(scutil --get LocalHostName 2>/dev/null || echo "$HUB_HOST")"
    echo "[ok] hub account: $(id -un) (this machine is the source of truth)" >&2
  else
    ask hubhost "Hub MagicDNS name (Tailscale)" "$HUB_HOST"
    hubuser="$USER"
    while : ; do
      ask hubuser "Hub local macOS username (run 'id -un' on the hub)" "$hubuser"
      if [ -n "$hubuser" ] && ssh $SSH_OPTS "$hubuser@$hubhost" "echo ok" >/dev/null 2>&1; then
        echo "[ok] connected as $hubuser@$hubhost" >&2
        ssh $SSH_OPTS "$hubuser@$hubhost" "command -v /opt/homebrew/bin/rsync >/dev/null 2>&1" \
          && rsyncpath="/opt/homebrew/bin/rsync"
        break
      fi
      [ -n "$hubuser" ] && warn "could not connect as '$hubuser@$hubhost'"
      echo "  hint: on the hub run 'id -un', and ensure 'sudo tailscale set --ssh' there" >&2
      [ -t 0 ] || { warn "non-interactive: leaving HUB_USER='$hubuser' (verify later with 'ymir status')"; break; }
      confirm "Try again with a different username?" Y || { warn "you can set HUB_USER later in $CFG_FILE"; break; }
    done
  fi

  # 3. write config
  if [ -f "$CFG_FILE" ] && ! confirm "Config exists at $CFG_FILE. Overwrite?" N; then
    echo "Keeping existing config." >&2
  else
    cat >"$CFG_FILE" <<EOF
# ymir config ($(hostname)) - generated by 'ymir setup'
HUB_HOST="$hubhost"
HUB_USER="$hubuser"
IS_HUB="$ishub"
TRANSPORT="ssh"
MIRROR="0"
INTERVAL="300"
HUB_RSYNC_PATH="$rsyncpath"
EOF
    echo "[ok] wrote $CFG_FILE" >&2
  fi

  # 4. put on PATH
  if ! command -v ymir >/dev/null 2>&1 && [ -d /opt/homebrew/bin ]; then
    local self; self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    if confirm "Symlink 'ymir' into /opt/homebrew/bin (PATH)?" Y; then
      ln -sf "$self" /opt/homebrew/bin/ymir && echo "[ok] linked /opt/homebrew/bin/ymir" >&2
    fi
  fi
  echo >&2

  # 5. role-specific finish
  if [ "$ishub" = "1" ]; then
    cat >&2 <<'EOF'
Hub setup done. Next:
  ymir add ~/.zshrc ~/.config/nvim   # define folders to distribute
  ymir list
  (then on each laptop)  ymir setup  ->  ymir sync
EOF
  else
    if confirm "Install the launchd auto-sync agent now?" Y; then cmd_install_agent || true; fi
    cat >&2 <<'EOF'
Spoke setup done. Next:
  ymir status
  ymir sync                          # pull managed paths from the hub
EOF
  fi
}

cmd_add() {
  local force=0; [ "${1:-}" = "--force" ] && { force=1; shift; }
  [ $# -ge 1 ] || die "usage: ymir add [--force] <path>..."
  build_excludes
  local in rel rb
  rb="$(rsync_bin)"
  for in in "$@"; do
    rel="$(to_rel "$in")"
    if is_secret "$rel" && [ "$force" -ne 1 ]; then
      warn "refusing secret-looking path '$rel' (use --force to override): skipped"; continue
    fi
    # seed: if present locally but missing on hub, push it up once
    if [ -e "$HOME/$rel" ]; then
      if ! hub_exec "test -e \$HOME/$rel"; then
        warn "seeding '$rel' -> hub"
        case "$TRANSPORT" in
          ssh)
            hub_exec "mkdir -p \$HOME/$(dirname "$rel")"
            "$rb" -a "${REX[@]}" -e "ssh $SSH_OPTS" "$HOME/$rel" "$HUB_USER@$HUB_HOST:$(dirname "$rel")/" ;;
          local)
            mkdir -p "$HUB_ROOT/$(dirname "$rel")"
            "$rb" -a "${REX[@]}" "$HOME/$rel" "$HUB_ROOT/$(dirname "$rel")/" ;;
        esac
      fi
    fi
    # register in hub manifest (deduped)
    hub_exec "mkdir -p \$HOME/.config/ymir; touch $REMOTE_MANIFEST; grep -qxF -- '$rel' $REMOTE_MANIFEST || printf '%s\n' '$rel' >> $REMOTE_MANIFEST"
    printf 'added: %s\n' "$rel"
  done
}

cmd_rm() {
  [ $# -ge 1 ] || die "usage: ymir rm <path>..."
  local in rel
  for in in "$@"; do
    rel="$(to_rel "$in")"
    hub_exec "test -f $REMOTE_MANIFEST && grep -vxF -- '$rel' $REMOTE_MANIFEST > $REMOTE_MANIFEST.tmp && mv $REMOTE_MANIFEST.tmp $REMOTE_MANIFEST || true"
    printf 'removed from manifest (local copy kept): %s\n' "$rel"
  done
}

cmd_list() {
  local m; m="$(read_manifest || true)"
  [ -n "$m" ] && printf '%s\n' "$m" || echo "(manifest empty)"
}

cmd_sync() {
  build_excludes
  if [ "$IS_HUB" = "1" ]; then
    echo "This machine is the hub (source of truth). Nothing to pull."; return 0
  fi
  local rb rel n=0 fail=0 delflag=() ; rb="$(rsync_bin)"
  [ "$MIRROR" = "1" ] && delflag=(--delete)
  local rpath=(); [ -n "$HUB_RSYNC_PATH" ] && rpath=(--rsync-path="$HUB_RSYNC_PATH")
  local manifest; manifest="$(read_manifest)" || die "cannot read hub manifest (hub unreachable?)"
  # cache manifest locally
  printf '%s\n' "$manifest" > "$LOCAL_MANIFEST"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    local isdir src dst
    isdir="$(hub_exec "test -d \$HOME/$rel && echo 1 || echo 0")"
    mkdir -p "$HOME/$(dirname "$rel")"
    if [ "$isdir" = "1" ]; then src_suffix="/"; else src_suffix=""; fi
    case "$TRANSPORT" in
      ssh)
        if "$rb" -a ${delflag[@]+"${delflag[@]}"} "${REX[@]}" ${rpath[@]+"${rpath[@]}"} -e "ssh $SSH_OPTS" \
              "$HUB_USER@$HUB_HOST:$rel$src_suffix" "$HOME/$rel$src_suffix"; then
          n=$((n+1)); else warn "sync failed: $rel"; fail=$((fail+1)); fi ;;
      local)
        if "$rb" -a ${delflag[@]+"${delflag[@]}"} "${REX[@]}" \
              "$HUB_ROOT/$rel$src_suffix" "$HOME/$rel$src_suffix"; then
          n=$((n+1)); else warn "sync failed: $rel"; fail=$((fail+1)); fi ;;
    esac
  done <<< "$manifest"
  date '+%Y-%m-%dT%H:%M:%S' > "$STATE_FILE"
  log "sync ok=$n fail=$fail mirror=$MIRROR"
  printf 'synced %d path(s), %d failed. mirror=%s\n' "$n" "$fail" "$MIRROR"
  [ "$fail" -eq 0 ]
}

cmd_status() {
  if [ "$IS_HUB" = "1" ]; then
    printf 'role:      HUB (%s) - source of truth\n' "$HUB_HOST"
  else
    printf 'role:      spoke -> hub %s@%s (transport=%s)\n' "${HUB_USER:-?}" "$HUB_HOST" "$TRANSPORT"
    if hub_exec "echo ok" >/dev/null 2>&1; then echo "reachable: yes"; else echo "reachable: NO"; fi
  fi
  local c; c="$(read_manifest 2>/dev/null | grep -c . || true)"
  printf 'managed:   %s path(s)\n' "${c:-0}"
  [ -f "$STATE_FILE" ] && printf 'last sync: %s\n' "$(cat "$STATE_FILE")" || echo "last sync: never"
}

cmd_install_agent() {
  local self plist label="com.ymir.sync"
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  plist="$HOME/Library/LaunchAgents/$label.plist"
  mkdir -p "$HOME/Library/LaunchAgents"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array><string>$self</string><string>sync</string></array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>$INTERVAL</integer>
  <key>StandardOutPath</key><string>$LOG_FILE</string>
  <key>StandardErrorPath</key><string>$LOG_FILE</string>
</dict></plist>
EOF
  launchctl unload "$plist" 2>/dev/null || true
  launchctl load "$plist"
  printf 'installed launchd agent: %s (every %ss)\n' "$plist" "$INTERVAL"
}

cmd_uninstall_agent() {
  local plist="$HOME/Library/LaunchAgents/com.ymir.sync.plist"
  launchctl unload "$plist" 2>/dev/null || true
  rm -f "$plist"
  echo "removed launchd agent"
}

usage() {
  cat <<'EOF'
ymir - pull-sync a managed list of config paths from a hub over Tailscale.

USAGE
  ymir <command> [args]
  ymir <command> --help      detailed help for one command
  ymir help [command]        this overview, or help for a command

COMMANDS
  setup                guided interactive setup (prereqs, config, PATH, agent)
  init                 write the config template (~/.config/ymir/config)
  add [--force] PATH.. register path(s) in the hub manifest (seeds new ones up)
  rm PATH..            unregister path(s); the local copy is kept
  list                 show managed paths (from the hub manifest)
  sync                 pull every managed path: hub -> this machine
  status               hub reachability, managed count, last sync time
  install-agent        install a launchd agent that runs `sync` on an interval
  uninstall-agent      remove the launchd agent
  help, --help, -h     show this overview

MODEL
  One-way pull. The hub (HUB_HOST) is the source of truth and
  owns the manifest + canonical files. Paths are stored HOME-relative so different
  local usernames map correctly. Files stay in place; secrets are excluded.

CONFIG   ~/.config/ymir/config   (run `ymir init` to create it)
  HUB_HOST HUB_USER TRANSPORT MIRROR INTERVAL HUB_RSYNC_PATH

Full guide: docs/GUIDE.md in the ymir repo.
EOF
}

help_topic() {
  case "$1" in
    setup) cat <<'EOF'
ymir setup - guided interactive setup.

  Walks you through everything: checks Tailscale + GNU rsync (offers to install
  rsync), asks whether this machine is the HUB or a SPOKE. For a spoke it verifies
  HUB_USER with a live SSH test and re-prompts until it connects, then writes
  ~/.config/ymir/config, optionally symlinks `ymir` onto PATH, and optionally
  installs the launchd agent.

  Re-runnable; it asks before overwriting an existing config. Prompts fall back to
  defaults when run non-interactively.

  Example:
    ymir setup
EOF
;;
    init) cat <<'EOF'
ymir init - write the config template.

  Creates ~/.config/ymir/config with commented defaults if it does not exist.
  Does NOT overwrite an existing config. After running it, set HUB_USER to the
  hub's local macOS account name (run `id -un` on the hub to find it).

  Example:
    ymir init
    $EDITOR ~/.config/ymir/config    # set HUB_USER="..."
    ymir status
EOF
;;
    add) cat <<'EOF'
ymir add [--force] PATH...

  Register one or more paths in the hub manifest so they get synced. A path may be
  absolute, ~-relative, or relative to the current directory. Paths under your home
  are stored HOME-relative (e.g. ".config/nvim"); paths outside home are stored
  absolute and will NOT remap across machines with different usernames.

  Seeding: if the path exists locally but not yet on the hub, its current content is
  pushed up to the hub once, making the hub the source of truth from then on.

  Secret guard: paths matching secret patterns (.ssh/*, id_rsa, *.pem, *.key,
  .aws/credentials, *.env, ...) are refused. Use --force to add one anyway.

  Run from any Mac: the manifest lives on the hub, so the managed set is shared.

  Examples:
    ymir add ~/.zshrc ~/.config/nvim
    ymir add ~/.config/ghostty          # a directory (synced recursively)
    ymir add --force ~/.config/app/token.env
EOF
;;
    rm|remove) cat <<'EOF'
ymir rm PATH...

  Remove path(s) from the hub manifest so they stop syncing. Your local copy and the
  hub copy are BOTH left in place; only the manifest entry is deleted. Accepts the
  same path forms as `add`.

  Example:
    ymir rm ~/.zshrc
EOF
;;
    list|ls) cat <<'EOF'
ymir list

  Print the managed paths, read live from the hub manifest
  (~/.config/ymir/paths.list on the hub). Requires the hub to be reachable.
EOF
;;
    sync) cat <<'EOF'
ymir sync

  Pull every managed path from the hub to this machine with rsync. Directories are
  synced recursively. Secret patterns are always excluded. Parent directories are
  created as needed. Records the timestamp for `status` and logs to the config dir.

  MIRROR=1 in the config adds `rsync --delete`, so files removed on the hub are also
  deleted here (destructive). Default MIRROR=0 only adds/updates, never deletes.

  This is the command the launchd agent runs on an interval.
EOF
;;
    status) cat <<'EOF'
ymir status

  Show the configured hub (user@host, transport), whether it is reachable, how many
  paths are managed, and when the last sync ran.
EOF
;;
    install-agent) cat <<'EOF'
ymir install-agent

  Write and load a launchd agent (~/Library/LaunchAgents/com.ymir.sync.plist) that
  runs `ymir sync` at login and every INTERVAL seconds (default 300). Re-running it
  reloads the agent with the current INTERVAL. Output goes to the ymir log.
EOF
;;
    uninstall-agent) cat <<'EOF'
ymir uninstall-agent

  Unload and delete the launchd agent. Does not touch your config or synced files.
EOF
;;
    *) usage ;;
  esac
}

main() {
  local sub="${1:-help}"; shift || true
  # Per-command help must work without loading config (never die on unset HUB_USER).
  case "${1:-}" in -h|--help) help_topic "$sub"; exit 0 ;; esac
  case "$sub" in
    setup)           cmd_setup "$@" ;;
    init)            cmd_init "$@" ;;
    add)             load_cfg; cmd_add "$@" ;;
    rm|remove)       load_cfg; cmd_rm "$@" ;;
    list|ls)         load_cfg; cmd_list "$@" ;;
    sync)            load_cfg; cmd_sync "$@" ;;
    status)          load_cfg; cmd_status "$@" ;;
    install-agent)   load_cfg; cmd_install_agent "$@" ;;
    uninstall-agent) cmd_uninstall_agent "$@" ;;
    help)            [ $# -ge 1 ] && help_topic "$1" || usage ;;
    -h|--help)       usage ;;
    *)               usage; exit 1 ;;
  esac
}
main "$@"
